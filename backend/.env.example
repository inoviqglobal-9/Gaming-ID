# ========================================================
# SECURE SCANNER & TRADER PANEL - ENVIRONMENT CONFIGURATION
# ========================================================
# Notice: Copy this file to .env and configure strong values.
# NEVER commit the real .env file or production secrets to Git.

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# Database Connection (MongoDB URI e.g., local MongoDB or MongoDB Atlas cluster)
MONGODB_URI=mongodb://127.0.0.1:27017/secure_scanner_trader

# Secure Session Secret (Use a long, cryptographically random secret string)
SESSION_SECRET=replace_with_a_long_random_secret_at_least_32_chars

# One-time Admin Bootstrap Credentials (Used ONLY by 'npm run bootstrap:admin')
# Choose a strong unique username and password. Never use default passwords.
ADMIN_USERNAME=your_admin_username
ADMIN_PASSWORD=replace_with_a_strong_unique_password

# Application Settings
MAX_BATCH_GENERATE_USERS=50
PAYIN_EXPIRY_MINUTES=60

# DNS Configuration (Optional: fallback resolvers when local ISP DNS blocks SRV records)
# Default public resolvers: 8.8.8.8 (Google), 1.1.1.1 (Cloudflare)
DNS_SERVERS=8.8.8.8,1.1.1.1

# Database Connection Timeout & Retry Settings
MONGODB_TIMEOUT_MS=10000
MONGODB_MAX_RETRIES=3
MONGODB_RETRY_DELAY_MS=2000

